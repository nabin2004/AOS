OPENROUTER_API_KEY="sk-or-v1-..."

# Model profile: cloud | hybrid | local | openai_compatible
# cloud (recommended for UI Animate): OpenRouter for classify/plan/coder — no Ollama needed
# hybrid: OpenRouter for classify/plan, Ollama for coder
# local: Ollama for everything
# openai_compatible: all roles use AOS_OPENAI_BASE_URL (BYOK / local OpenAI-compatible servers)
AOS_MODEL_PROFILE=cloud

# Defaults used by profiles
AOS_OLLAMA_MODEL=ollama:huggingface.co/nabin2004/AOS-gemma4-31b-manim-gguf:Q4_K_M
AOS_OPENROUTER_MODEL=openrouter:openai/gpt-4o-mini

# OpenAI-compatible BYOK (set by UI Celery worker when chat provides a custom base URL)
# AOS_OPENAI_BASE_URL=http://localhost:11434/v1
# AOS_OPENAI_API_KEY=local
# AOS_OPENAI_MODEL=llama3.2

# Per-role overrides (optional — beat profile)
# AOS_CLASSIFIER_MODEL=openrouter:openai/gpt-4o-mini
# AOS_PLANNER_MODEL=openrouter:openai/gpt-4o-mini
# AOS_CODER_MODEL=ollama:huggingface.co/nabin2004/AOS-gemma4-31b-manim-gguf:Q4_K_M
# AOS_ANIMATION_MODEL=openrouter:openai/gpt-4o-mini

# Ollama OpenAI-compatible endpoint (required when using local/hybrid coder)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Output token cap for local models (keep prompt + max_tokens <= num_ctx)
AOS_CODER_MAX_TOKENS=2048
AOS_MAX_TOKENS=2048

# Ollama context window (passed per request via options.num_ctx)
AOS_OLLAMA_NUM_CTX=16384

# Disable Gemma thinking/reasoning on Ollama (default off — saves context on CodeMode retries)
# Set to 1 to enable extended reasoning traces from the local model.
AOS_OLLAMA_THINKING=0

# MinIO / S3 configuration for saving generated videos
S3_VIDEO_ENDPOINT=http://localhost:9010
S3_VIDEO_ACCESS_KEY=minioadmin
S3_VIDEO_SECRET_KEY=minioadmin
S3_VIDEO_BUCKET=aos-videos
S3_VIDEO_REGION=us-east-1
