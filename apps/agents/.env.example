OPENROUTER_API_KEY="sk-or-v1-..."

# Model profile: hybrid | local | cloud
# hybrid (default): OpenRouter for classify/plan/orchestrator, Ollama for coder
AOS_MODEL_PROFILE=hybrid

# Defaults used by profiles
AOS_OLLAMA_MODEL=ollama:huggingface.co/nabin2004/AOS-gemma4-31b-manim-gguf:Q4_K_M
AOS_OPENROUTER_MODEL=openrouter:openai/gpt-4o-mini

# Per-role overrides (optional — beat profile)
# AOS_CLASSIFIER_MODEL=openrouter:openai/gpt-4o-mini
# AOS_PLANNER_MODEL=openrouter:openai/gpt-4o-mini
# AOS_CODER_MODEL=ollama:huggingface.co/nabin2004/AOS-gemma4-31b-manim-gguf:Q4_K_M
# AOS_ANIMATION_MODEL=openrouter:openai/gpt-4o-mini

# Ollama OpenAI-compatible endpoint (required when using local models)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Output token cap for local models (keep prompt + max_tokens <= num_ctx)
AOS_CODER_MAX_TOKENS=2048
AOS_MAX_TOKENS=2048

# Ollama context window (passed per request via options.num_ctx)
AOS_OLLAMA_NUM_CTX=16384

# Disable Gemma thinking/reasoning on Ollama (default off — saves context on CodeMode retries)
# Set to 1 to enable extended reasoning traces from the local model.
AOS_OLLAMA_THINKING=0
