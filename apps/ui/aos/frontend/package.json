{
  "name": "aos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/next-with-root.mjs dev -p 3000",
    "build": "node ./scripts/next-with-root.mjs build",
    "analyze": "ANALYZE=true node ./scripts/next-with-root.mjs build",
    "start": "node ./scripts/next-with-root.mjs start -p 3000",
    "lint": "node ./scripts/with-project-root.mjs eslint .",
    "lint:fix": "node ./scripts/with-project-root.mjs eslint . --fix",
    "format": "node ./scripts/with-project-root.mjs prettier --write .",
    "format:check": "node ./scripts/with-project-root.mjs prettier --check .",
    "type-check": "node ./scripts/with-project-root.mjs tsc --noEmit",
    "prepare": "node ./scripts/with-project-root.mjs husky",
    "test:e2e": "node ./scripts/with-project-root.mjs playwright test",
    "test:e2e:ui": "node ./scripts/with-project-root.mjs playwright test --ui",
    "test:e2e:headed": "node ./scripts/with-project-root.mjs playwright test --headed",
    "test:e2e:debug": "node ./scripts/with-project-root.mjs playwright test --debug",
    "test:e2e:report": "node ./scripts/with-project-root.mjs playwright show-report",
    "test": "node ./scripts/with-project-root.mjs vitest",
    "test:run": "node ./scripts/with-project-root.mjs vitest run",
    "test:coverage": "node ./scripts/with-project-root.mjs vitest run --coverage",
    "test:ui": "node ./scripts/with-project-root.mjs vitest --ui"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.6",
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/mdx": "^2.0.13",
    "@vercel/otel": "^1.10.0",
    "@videojs/react": "^10.0.0-beta.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.23",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.0",
    "next-intl": "^3.25.3",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.1",
    "recharts": "^3.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mdx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
