# Copy to config.env and fill in your GCP settings.
#   cp config.example.env config.env

GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-project-aos-training
ARTIFACT_REPO=aos-training

# Default GPU for Gemma 4 4-bit + long context
MACHINE_TYPE=a2-highgpu-1g
ACCELERATOR_TYPE=NVIDIA_TESLA_A100
ACCELERATOR_COUNT=1
BOOT_DISK_GB=500

# Container tags pushed by build.sh
SFT_IMAGE_TAG=sft
GRPO_IMAGE_TAG=grpo

# GCS paths (no gs:// prefix on bucket-relative paths)
DATA_OBJECT=data/trajectories.jsonl
SFT_OUTPUT_PREFIX=artifacts/sft
GRPO_OUTPUT_PREFIX=artifacts/grpo

# Hugging Face token for google/gemma-4-E2B-it (also set in shell env)
# HF_TOKEN=hf_...

# Weights & Biases (set in apps/training/.env or shell env; never commit keys)
# WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT_SFT=aos-sft
WANDB_PROJECT_GRPO=aos-grpo
