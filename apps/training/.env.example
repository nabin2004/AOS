# Copy to apps/training/.env or repository root .env and fill in keys (never commit .env).
#   cp apps/training/.env.example apps/training/.env

# Weights & Biases API Key (for tracking experiments & ManiBench eval metrics)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_ENTITY=your_wandb_entity

# Hugging Face Access Token (for private datasets, Hub model uploads, & rate limits)
HF_TOKEN=your_hf_token_here

# Per-stage W&B projects (run.py sets these when WANDB_PROJECT is unset)
WANDB_PROJECT_SFT=aos-sft
WANDB_PROJECT_QWEN_SFT=aos-qwen-sft
WANDB_PROJECT_DPO=aos-dpo
WANDB_PROJECT_GRPO=aos-grpo
