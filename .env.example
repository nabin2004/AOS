# ==============================================================================
# AOS (Agentic Orchestration System) - Unified Environment Configuration
# ==============================================================================
# Copy this file to .env in the repository root:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows PowerShell / CMD)
# ==============================================================================

# === Core System ===
PROJECT_NAME=aos
ENVIRONMENT=local
DEBUG=true
TIMEZONE=UTC
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_KEY=change-me-in-production

# === AI Providers & Keys ===
# Supply at least one valid LLM provider key or use local Ollama
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Model Profiles: 'cloud' (OpenRouter), 'local' (Ollama), 'hybrid'
AOS_MODEL_PROFILE=cloud
AI_MODEL=anthropic/claude-3.5-sonnet
# For local Ollama running on your host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# === PostgreSQL Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aos
POSTGRES_PORT=5432

# === Redis Cache & Celery Broker ===
REDIS_PORT=6379

# === MinIO Object Storage (Videos & RAG) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

S3_VIDEO_ACCESS_KEY=minioadmin
S3_VIDEO_SECRET_KEY=minioadmin
S3_VIDEO_BUCKET=aos-videos

S3_RAG_ACCESS_KEY=minioadmin
S3_RAG_SECRET_KEY=minioadmin
S3_RAG_BUCKET=aos-rag

# === Milvus Vector Database ===
MILVUS_PORT=19530

# === Celery Video Generation & Agents ===
AGENTS_UV_CMD=uv
AOS_RENDER_TIMEOUT_SECONDS=600

# === Frontend Configuration ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_RAG_ENABLED=true
