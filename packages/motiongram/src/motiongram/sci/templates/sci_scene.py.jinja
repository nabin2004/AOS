# ── Scientific palette helpers (perceptually-uniform) ─────────────────────
def viridis_color(t: float) -> ManimColor:
    """Sample a viridis-like perceptually-uniform gradient at t ∈ [0,1]."""
    stops = [
        np.array([68, 1, 84]),
        np.array([59, 82, 139]),
        np.array([33, 145, 140]),
        np.array([94, 201, 98]),
        np.array([253, 231, 37]),
    ]
    t = float(np.clip(t, 0.0, 1.0))
    idx = t * (len(stops) - 1)
    lo, hi = int(idx), min(int(idx) + 1, len(stops) - 1)
    frac = idx - lo
    rgb = stops[lo] * (1 - frac) + stops[hi] * frac
    return ManimColor(f"#{int(rgb[0]):02x}{int(rgb[1]):02x}{int(rgb[2]):02x}")

